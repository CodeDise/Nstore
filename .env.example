# NOHARA STORE BOT — environment variables
# Copy these into Render -> Environment (NEVER commit a real .env file)

# Telegram (from https://my.telegram.org -> API development tools)
API_ID=123456
API_HASH=replace_with_your_api_hash

# Master bot token (from @BotFather)
MASTER_BOT_TOKEN=123456789:replace_with_master_bot_token

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Encryption key: ANY long random text (at least 32 characters, 50+ is better;
# letters + digits, no spaces). Keep it forever.
ENCRYPTION_KEY=replace_with_long_random_text

# Your own Telegram user id(s), comma separated (platform admins)
ADMIN_IDS=123456789

# Optional: private channel for master audit logs (bot must be admin). 0 = off
MASTER_AUDIT_CHANNEL_ID=0

# Public HTTPS URL. Render fills RENDER_EXTERNAL_URL automatically, so leave empty
APP_URL=

# Optional tuning
# DEFAULT_LANGUAGE=en
# DEFAULT_FONT_STYLE=default_html
# DEFAULT_USD_TO_INR=88.0
# MAX_CLONES_PER_USER=3
# MAX_CLONES_TOTAL=15
# BUTTON_COLORS=true
# OXAPAY_SANDBOX=false
